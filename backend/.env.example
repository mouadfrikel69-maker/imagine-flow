# ──────────────────────────────────────────────────────────────────────────────
# ImagineFlow backend — environment variables
#
# Copy this file to `.env` for local dev. On Render, paste these values in
# Service → Environment instead. Never commit a populated `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# ── Pollinations ─────────────────────────────────────────────────────────────
# The shared "developer" Pollinations API key used for Google/email-only
# users (the 6/day tier). Get one at https://enter.pollinations.ai.
DEV_POLLINATIONS_API_KEY=sk_your_key_here
# Legacy alias — accepted by the older /api/* endpoints used by the web frontend.
# POLLINATIONS_API_KEY=sk_your_key_here

# Optional Pollinations overrides
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai
# POLLINATIONS_VISION_MODEL=openai
# ALLOWED_ORIGINS=*

# ── Firebase Admin (server side) ─────────────────────────────────────────────
# Paste the entire service-account JSON as a single string. Render's env-var
# editor handles multi-line values fine. Do NOT commit this anywhere.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","..."}
# Optional — only needed if your service account JSON is missing project_id.
# FIREBASE_PROJECT_ID=imagine-flow

# Firebase Realtime Database URL. Find it in Firebase Console → Build →
# Realtime Database → top of the page. It's one of:
#   https://<project>-default-rtdb.firebaseio.com
#   https://<project>-default-rtdb.<region>.firebasedatabase.app
# Required — without it the Admin SDK can't talk to your database.
FIREBASE_DATABASE_URL=https://imagine-flow-default-rtdb.firebaseio.com

# ── Encryption ───────────────────────────────────────────────────────────────
# Fernet symmetric key used to encrypt user-supplied Pollinations keys at
# rest in Realtime Database. Generate ONCE with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Save the result in your password manager — losing it makes every user's
# stored key permanently unrecoverable.
MASTER_KEY=
