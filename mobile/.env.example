# ──────────────────────────────────────────────────────────────────────────────
# ImagineFlow mobile — environment variables
#
# Copy this file to `.env` and fill in your real values. Anything prefixed with
# `EXPO_PUBLIC_` is bundled into the JS at build time, so do NOT put server-side
# secrets here. The Firebase Web API key is safe to ship — Firebase enforces
# auth rules on the backend.
# ──────────────────────────────────────────────────────────────────────────────

# Backend URL (Render). Include scheme and NO trailing slash.
EXPO_PUBLIC_API_URL=https://imagine-flow-api.onrender.com

# From Firebase console → Project settings → Your apps → Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth client IDs from Google Cloud Console (or Firebase auto-creates them).
# - Web client ID is required (used by expo-auth-session in Expo Go and web).
# - Android client ID is needed once you build a standalone APK with EAS.
# - iOS is only needed if you target iOS later.
EXPO_PUBLIC_FIREBASE_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_FIREBASE_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_FIREBASE_GOOGLE_IOS_CLIENT_ID=
